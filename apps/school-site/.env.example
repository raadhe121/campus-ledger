# Optional — which school shows at the bare "/" root, e.g. when this
# deployment sits behind one school's own custom domain. Leave unset (the
# normal case) and this one deployment still serves any published school:
# the slug in the URL path (/:slug) is what actually picks the school,
# resolved fresh on every visit, so adding a new school never needs a
# rebuild or a new deployment.
# VITE_SCHOOL_SLUG=riverside-high

# The shared Campus Ledger API every school-site deployment reads from —
# the same backend, same database, tenant-isolated as everywhere else in
# this app. Only /api/v1/public/* is ever called from here.
VITE_API_URL=http://localhost:4000/api/v1

# Server-side only (no VITE_ prefix — never bundled into client JS): which
# local port this instance's dev/preview server binds. Not needed in a
# real deployment, where the platform (or a reverse proxy) picks the port.
PORT=5300
