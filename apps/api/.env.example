PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://campus_ledger:campus_ledger@localhost:5432/campus_ledger?schema=public"
# Provisioned by docker-compose for local dev; nothing in the app reads it
# yet, so it's optional — omit it entirely in production unless/until
# something actually uses it.
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

WEB_ORIGIN="http://localhost:5173"

# Powers the AI Assistant chat widget (every role) and the dummy
# audio-to-text page, both via Groq's OpenAI-compatible API. Get a key at
# https://console.groq.com/keys — the app still boots without it, but
# /api/v1/assistant/chat and /api/v1/dev/transcribe return a clear error
# until set.
GROQ_API_KEY=""
